# Backend Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://lassa_admin:lassa_secure_password@localhost:5432/lassa_dashboard
DB_HOST=localhost
DB_PORT=5432
DB_USER=lassa_admin
DB_PASSWORD=lassa_secure_password
DB_NAME=lassa_dashboard

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PORT=5000

# Logging
LOG_LEVEL=info
